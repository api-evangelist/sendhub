          "request": {
            "name": "List Threads",
            "description": {
              "content": "Gets a list of inbox threads\n\n**Note:** the URL **must** include the forward-slash after /v1/inbox\n\nThe `next` field in the `meta` object doesn't include this forward-slash in the URI it provides\n\nWe suggest constructing your URIs via your code and using the `next` field to determine if there's a next page (eg. if `next` is null)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "inbox"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "(Pagination) How many records to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "(Pagination) How many records to skip"
                }
              ],
              "variable": []
            },
